context:
  meta:
    settings:
    - target_tone_frequency
    - target_tone_level
  parameters:
    acquisition:
      ordering:
        rove: false
        selected: conventional
    artifact_reject:
      detrend_mode:
        rove: false
        selected: Constant
      reject_mode:
        rove: false
        selected: absolute value
      reject_threshold:
        expression: '1'
        rove: false
    averaging:
      alternate_polarity:
        expression: 'True'
        rove: false
      averages:
        expression: '1024'
        rove: false
      rate:
        expression: '40'
        rove: false
    digital_filter_settings:
      digital_filter:
        expression: 'True'
        rove: false
      digital_highpass:
        expression: '300'
        rove: false
      digital_lowpass:
        expression: '3000'
        rove: false
    inear_calibration:
      calibration_gain:
        expression: '-30'
        rove: false
    system_starship_settings:
      system_output:
        rove: false
        selected: primary
    target:
      target_tone_burst_duration:
        expression: 5e-3
        rove: false
      target_tone_burst_rise_time:
        expression: '0.5e-3'
        rove: false
      target_tone_burst_start_time:
        expression: '0.0'
        rove: false
      target_tone_frequency:
        expression: '1000.0'
        rove: true
      target_tone_level:
        expression: '60.0'
        rove: true
      target_tone_phase:
        expression: '0'
        rove: false
      target_tone_polarity:
        rove: false
        selected: positive
  selectors:
    default:
      context_item_order:
      - target_tone_frequency
      - target_tone_level
      context_settings:
        target_tone_frequency:
          end: 4.0
          sequence_type: range
          start: 4.0
          step: 0.5
        target_tone_level:
          end: 80.0
          sequence_type: range
          start: 20.0
          step: 10.0
